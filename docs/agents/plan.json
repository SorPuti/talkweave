  },
  "run": "python run.py",
  "resume": "python run.py --resume",
  "console": "python run.py --ui",
  "reports": [
    "work/talkweave-demo/REPORT.md",
    "work/talkweave-demo/report.json",
    "work/talkweave-demo/logs/"
  ],
  "steps": [
    {
      "id": "01-baseline",
      "command": "python src/baseline.py",
      "requires": [],
      "expected_files": [
        "baseline.npz"
      ],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#logistica"
    },
    {
      "id": "02-fixture",
      "command": "python src/fixture.py",
      "requires": [
        "01-baseline"
      ],
      "expected_files": [
        "data/train.jsonl",
        "data/validation.jsonl"
      ],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#dados"
    },
    {
      "id": "03-tests",
      "command": "python -m pytest -q",
      "requires": [
        "02-fixture"
      ],
      "expected_files": [],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#rede"
    },
    {
      "id": "04-codec",
      "command": "python src/train.py codec --manifest data/train.jsonl --validation data/validation.jsonl --steps 100",
      "requires": [
        "03-tests"
      ],
      "expected_files": [
        "runs/codec.pt"
      ],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#codec"
    },
    {
      "id": "05-reconstruction",
      "command": "python src/reconstruct.py --input data/validation-user.wav --output reconstructed.wav",
      "requires": [
        "04-codec"
      ],
      "expected_files": [
        "reconstructed.wav"
      ],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#codec"
    },
    {
      "id": "06-duplex",
      "command": "python src/train.py duplex --manifest data/train.jsonl --validation data/validation.jsonl --steps 100",
      "requires": [
        "05-reconstruction"
      ],
      "expected_files": [
        "runs/duplex.pt"
      ],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#treino"
    },
    {
      "id": "07-generation",
      "command": "python src/infer.py --input data/validation-user.wav --output reply.wav",
      "requires": [
        "06-duplex"
      ],
      "expected_files": [
        "reply.wav",
        "reply.wav.json"
      ],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#resposta"
    },
    {
      "id": "08-evaluation",
      "command": "python src/evaluate.py --manifest data/validation.jsonl --report reply.wav.json",
      "requires": [
        "07-generation"
      ],
      "expected_files": [],
      "verify": "Exit code 0, log persisted, expected files present and hashed. Does not establish voice quality.",
      "chapter": "https://sorputi.github.io/talkweave/#avaliacao"
    }
  ],
